# Copiar a .env.local. Nunca usar NEXT_PUBLIC_ para claves.
AI_ENABLED=false
# Proveedor por defecto: Gemini (clave gratuita en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Opcional. Por defecto gemini-3.5-flash-lite
GEMINI_MODEL=
# Otros proveedores (de pago): AI_PROVIDER=openai | anthropic
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
APP_ORIGIN=http://127.0.0.1:3100
# Enlaces públicos autorizados a usar la IA (vacío = desactivada en enlaces compartidos)
# AI_ALLOWED_ORIGINS=https://tu-enlace.devtunnels.ms
